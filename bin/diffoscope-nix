#!/usr/bin/env bash
set -euo pipefail

# --- easily removable: refuse to run outside a systemd-run sandbox ---
# diffoscope parses arbitrary binaries/archives with lots of helper tools,
# so run it via safe-run (systemd-run --user). Delete this block to disable.
if [[ -z "${SYSTEMD_EXEC_PID:-}" ]]; then
    echo "diffoscope-nix: not running under systemd-run; run it via safe-run (or remove this check)" >&2
    exit 1
fi
# --- end of systemd check ---

usage() {
    cat >&2 <<'EOF'
usage: diffoscope-nix [-n|--dry-run] [--keep-build-id] $path1 $path2 [diffoscope args...]

Run diffoscope on two Nix store paths (files or directories), ignoring
differences that are only due to differing store path hashes, such as
RPATHs or embedded references (and the matching hex dump lines).

Works by copying each input to a temp dir and replacing every
/nix/store/<32-char hash> in file contents and symlink targets with a
constant placeholder (same length, so offsets don't move), then running
diffoscope on the copies. Mtimes and modes are preserved.

Upper-cased store paths ("/nix/store/RJXGV8QS...-qtbase", as embedded by
some debug builds) are handled too, replaced by an upper-case placeholder.

Store paths stored as UTF-16LE (Qt string literals) are handled too.

Relative references without the /nix/store prefix are handled too, e.g.
"${CMAKE_CURRENT_LIST_DIR}/../../../../<hash>-name" in CMake config files
or "../<hash>-name" symlink targets: any path component that is 32
nixbase32 characters followed by "-name" has its hash replaced.

Gzip files (detected by their magic bytes, e.g. man pages) that contain a
store hash are decompressed, rewritten and recompressed (without name or
timestamp in the gzip header), so the same content gives byte-identical
files on both sides. Gzip files without a store hash are left as they
are. Other compressed formats (xz, zstd, bzip2, zip/jar, ...) are not
looked into.

Hashes of *different* dependencies are masked too, so a dependency being
swapped for another build of the same name won't show up -- but a changed
name or version (qttools-6.12.0 -> qttools-6.13.0) still will.

Options:
  -n, --dry-run   Don't copy or run anything; list which files/symlinks
                  would be rewritten and the diffoscope command line.
  --keep-build-id
                  Don't zero the GNU build ID. By default the build ID
                  (NT_GNU_BUILD_ID note, i.e. .note.gnu.build-id) is zeroed
                  in every ELF file. The ID is a hash of the build, so it
                  differs whenever anything else does. Its bytes can also
                  sit right in front of a string such as the interpreter
                  path, where `strings` glues any printable ones onto it
                  (yD/nix/store/...-ld-linux-x86-64.so.2), so zeroing it
                  removes that noise as well. Doesn't touch anything derived
                  from the ID, such as .build-id/xx/yyyy.debug file names or
                  .gnu_debuglink checksums.
  -h, --help      Show this help.

Anything after the two paths is passed to diffoscope unchanged,
e.g.: diffoscope-nix $a $b --html out.html
diffoscope is always run with --text-color always (colors even when
piped); pass --text-color auto or never after the paths to override.
A note is printed to stderr only when build IDs are kept (--keep-build-id).
Exit status is diffoscope's (1 = differences found).
EOF
}

dry_run=0
strip_build_id=1
while (( $# )); do
    case $1 in
        -n|--dry-run) dry_run=1; shift ;;
        --keep-build-id) strip_build_id=0; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) echo "diffoscope-nix: unknown option: $1 (put diffoscope options after the two paths)" >&2
            usage; exit 2 ;;
        *) break ;;
    esac
done

if (( $# < 2 )); then
    usage
    exit 2
fi
src_a=$1
src_b=$2
shift 2
extra_args=("$@")

command -v diffoscope >/dev/null || { echo "diffoscope-nix: diffoscope not found in PATH" >&2; exit 127; }
for p in "$src_a" "$src_b"; do
    [[ -e $p ]] || { echo "diffoscope-nix: no such path: $p" >&2; exit 2; }
done

# Printed to stderr just before the diff, so it doesn't end up in
# diffoscope's own output (e.g. when that is piped, or --json/--html -).
# Only for the non-default case (build IDs kept); the default is silent.
print_banner() {
    if (( ! strip_build_id )); then
        echo "diffoscope-nix: GNU build IDs are KEPT (build ID differences will show)" >&2
    fi
}

read -r -d '' NORMALIZE_PL <<'EOF' || true
use strict;
use warnings;
use File::Find;
use IO::Uncompress::Gunzip qw(gunzip $GunzipError);
use IO::Compress::Gzip qw(gzip $GzipError);
use Time::HiRes qw(utime stat lstat);

# Perl has no way to set a symlink's own mtime, so collect the recreated
# links by mtime and fix them up with one `touch -h` per distinct mtime.
my %link_times;

my $list = (shift(@ARGV) eq '--list');
my $strip_bid = shift(@ARGV);
my $re = qr{/nix/store/[0-9a-df-np-sv-z]{32}};
my $ph = '/nix/store/' . ('e' x 32);
# Some builds embed the path upper-cased (e.g. "/nix/store/RJXGV8QS...-qtbase"
# in the assert strings of a Qt debug build).  The placeholder is upper-cased
# too, so a case change between the builds would still show up.
my $re_up = qr{/nix/store/[0-9A-DF-NP-SV-Z]{32}};
my $ph_up = '/nix/store/' . ('E' x 32);
# Relative references to a sibling store path, with no /nix/store prefix,
# e.g. "${CMAKE_CURRENT_LIST_DIR}/../../../../<hash>-name" in *Config.cmake.
# A whole path component of 32 nixbase32 characters followed by "-name".
my $re_rel = qr{(?<=/)[0-9a-df-np-sv-z]{32}(?=-[A-Za-z0-9])};
my $hash_ph = 'e' x 32;

sub fix {
    my ($s) = @_;
    (my $n = $s) =~ s/$re/$ph/g;
    $n =~ s/$re_up/$ph_up/g;
    # UTF-16LE string literals (QString/char16_t data in .rodata):
    # "/\0n\0i\0x\0/\0s\0t\0o\0r\0e\0/\0" then the hash, one char per 2 bytes.
    $n =~ s/(?<=\/\0n\0i\0x\0\/\0s\0t\0o\0r\0e\0\/\0)(?:[0-9a-df-np-sv-z]\0){32}/"e\0" x 32/ge;
    $n =~ s/$re_rel/$hash_ph/g;
    return $n;
}

# Zero the descriptor of every NT_GNU_BUILD_ID note in an ELF image, in
# place (same length, so nothing moves). Notes are found through both the
# PT_NOTE segments and the SHT_NOTE sections, so stripped-of-sections files
# work too. Returns how many non-zero build IDs it cleared.
sub zero_build_ids {
    my ($r) = @_;
    return 0 unless length($$r) >= 52 && substr($$r, 0, 4) eq "\x7fELF";
    my $class = ord(substr($$r, 4, 1));    # 1 = 32-bit, 2 = 64-bit
    my $data  = ord(substr($$r, 5, 1));    # 1 = little, 2 = big endian
    return 0 unless ($class == 1 || $class == 2) && ($data == 1 || $data == 2);
    my $is64 = $class == 2;
    my ($u16, $u32, $u64) = $data == 1 ? ('v', 'V', 'Q<') : ('n', 'N', 'Q>');
    my $uw = $is64 ? $u64 : $u32;
    my $wl = $is64 ? 8 : 4;
    my $len = length($$r);
    my $rd = sub {    # ($offset, $template, $bytes) -> value, or undef out of range
        my ($o, $t, $n) = @_;
        return undef if $o < 0 || $o + $n > $len;
        return unpack($t, substr($$r, $o, $n));
    };

    my ($phoff, $shoff, $phentsize, $phnum, $shentsize, $shnum) = $is64
        ? ($rd->(0x20, $u64, 8), $rd->(0x28, $u64, 8), $rd->(0x36, $u16, 2),
           $rd->(0x38, $u16, 2), $rd->(0x3A, $u16, 2), $rd->(0x3C, $u16, 2))
        : ($rd->(0x1C, $u32, 4), $rd->(0x20, $u32, 4), $rd->(0x2A, $u16, 2),
           $rd->(0x2C, $u16, 2), $rd->(0x2E, $u16, 2), $rd->(0x30, $u16, 2));
    return 0 unless defined($phoff) && defined($shoff) && defined($phentsize)
        && defined($phnum) && defined($shentsize) && defined($shnum);

    my @regions;    # [offset, size, alignment]
    for my $i (0 .. $phnum - 1) {
        my $h = $phoff + $i * $phentsize;
        my $type = $rd->($h, $u32, 4);
        last unless defined $type;
        next unless $type == 4;    # PT_NOTE
        my ($off, $sz, $al) = $is64
            ? ($rd->($h + 8, $u64, 8), $rd->($h + 32, $u64, 8), $rd->($h + 48, $u64, 8))
            : ($rd->($h + 4, $u32, 4), $rd->($h + 16, $u32, 4), $rd->($h + 28, $u32, 4));
        push @regions, [$off, $sz, $al] if defined($off) && defined($sz) && defined($al);
    }
    for my $i (0 .. $shnum - 1) {
        my $h = $shoff + $i * $shentsize;
        my $type = $rd->($h + 4, $u32, 4);
        last unless defined $type;
        next unless $type == 7;    # SHT_NOTE
        my ($off, $sz, $al) = $is64
            ? ($rd->($h + 24, $u64, 8), $rd->($h + 32, $u64, 8), $rd->($h + 48, $u64, 8))
            : ($rd->($h + 16, $u32, 4), $rd->($h + 20, $u32, 4), $rd->($h + 32, $u32, 4));
        push @regions, [$off, $sz, $al] if defined($off) && defined($sz) && defined($al);
    }

    my $cleared = 0;
    for my $reg (@regions) {
        my ($off, $sz, $al) = @$reg;
        my $step = ($al && $al >= 8) ? 8 : 4;    # note padding
        my $end = $off + $sz;
        next if $end > $len;
        my $pos = $off;
        while ($pos + 12 <= $end) {
            my ($namesz, $descsz, $type) = unpack("$u32 $u32 $u32", substr($$r, $pos, 12));
            my $nameoff = $pos + 12;
            my $descoff = $nameoff + int(($namesz + $step - 1) / $step) * $step;
            my $next    = $descoff + int(($descsz + $step - 1) / $step) * $step;
            last if $next > $end || $next <= $pos;    # malformed
            if ($type == 3 && $namesz == 4 && substr($$r, $nameoff, 4) eq "GNU\0" && $descsz > 0) {
                my $d = substr($$r, $descoff, $descsz);
                if ($d =~ /[^\0]/) {
                    substr($$r, $descoff, $descsz) = "\0" x $descsz;
                    $cleared++;
                }
            }
            $pos = $next;
        }
    }
    return $cleared;
}

find({ no_chdir => 1, wanted => sub {
    my $f = $File::Find::name;
    if (-l $f) {
        my $t = readlink($f);
        my $n = fix($t);
        return if $n eq $t;
        if ($list) { print "  symlink $f\n"; return; }
        my $dir = $File::Find::dir;
        my @pst = stat($dir);
        my @st  = lstat($f);
        # store dirs are 0555; make the parent writable while we swap the link
        chmod($pst[2] | 0200, $dir);
        unlink($f) or die "unlink $f: $!";
        symlink($n, $f) or die "symlink $f: $!";
        push @{ $link_times{$st[9]} }, $f;
        chmod($pst[2] & 07777, $dir);
        utime($pst[8], $pst[9], $dir);
    } elsif (-f _) {
        my @st = stat($f);
        open(my $in, '<:raw', $f) or die "open $f: $!";
        local $/;
        my $c = <$in>;
        close($in);
        # gzip (e.g. man pages): the hashes are only visible after
        # decompressing, and a different hash changes the compressed bytes
        # and size, so rewrite the decompressed data and recompress it the
        # same way on both sides.  Untouched unless it has a store hash.
        my ($n, $gz);
        if (substr($c, 0, 2) eq "\x1f\x8b") {
            my $plain;
            if (gunzip(\$c => \$plain, MultiStream => 1)) {
                my $fixed = fix($plain);
                return if $fixed eq $plain;
                my $out;
                gzip(\$fixed => \$out, Minimal => 1) or die "gzip $f: $GzipError";
                ($n, $gz) = ($out, 1);
            }
        }
        $n = fix($c) unless defined $n;
        my $bids = ($strip_bid && !$gz) ? zero_build_ids(\$n) : 0;
        return if $n eq $c;
        if ($list) {
            my @why;
            push @why, 'build-id' if $bids;
            push @why, 'store hashes in gzip contents' if $gz;
            push @why, 'store hashes' if !$gz && fix($c) ne $c;
            print "  file    $f (", join(', ', @why), ")\n";
            return;
        }
        chmod($st[2] | 0200, $f);
        open(my $out, '>:raw', $f) or die "write $f: $!";
        print $out $n;
        close($out);
        chmod($st[2] & 07777, $f);
        utime($st[8], $st[9], $f);
    }
}}, @ARGV);

for my $mtime (keys %link_times) {
    my @links = @{ $link_times{$mtime} };
    while (my @chunk = splice(@links, 0, 500)) {
        system('touch', '-h', '-d', '@' . $mtime, '--', @chunk) == 0
            or warn "touch -h failed for $mtime\n";
    }
}
EOF

# /nix/store/<hash>-name -> name, so both copies get identical paths
strip_name() {
    basename -- "$1" | sed -E 's/^[0-9a-df-np-sv-z]{32}-//'
}

name_a=$(strip_name "$src_a")
name_b=$(strip_name "$src_b")

if (( dry_run )); then
    echo "[dry-run] would create a temp dir and copy:"
    echo "[dry-run]   $src_a -> <tmp>/a/$name_a"
    echo "[dry-run]   $src_b -> <tmp>/b/$name_b"
    what="store hashes"
    if (( strip_build_id )); then what+=" and GNU build IDs"; fi
    for p in "$src_a" "$src_b"; do
        echo "[dry-run] would rewrite $what in (from $p):"
        perl -e "$NORMALIZE_PL" -- --list "$strip_build_id" "$p"
    done
    echo "[dry-run] would run: diffoscope --text-color always ${extra_args[*]:+${extra_args[*]} }<tmp>/a/$name_a <tmp>/b/$name_b"
    if (( ! strip_build_id )); then
        echo "[dry-run] would print this banner first:"
        print_banner
    fi
    exit 0
fi

tmp=$(mktemp -d)
cleanup() {
    chmod -R u+w "$tmp" 2>/dev/null || true
    rm -rf "$tmp"
}
trap cleanup EXIT

mkdir "$tmp/a" "$tmp/b"
# -H: follow a symlink given on the command line (e.g. ./result)
cp -aH -- "$src_a" "$tmp/a/$name_a"
cp -aH -- "$src_b" "$tmp/b/$name_b"

perl -e "$NORMALIZE_PL" -- --apply "$strip_build_id" "$tmp/a/$name_a"
perl -e "$NORMALIZE_PL" -- --apply "$strip_build_id" "$tmp/b/$name_b"

print_banner
rc=0
# --text-color always keeps colors even when piped (e.g. into a pager);
# it comes first so a --text-color given after the paths overrides it.
diffoscope --text-color always "${extra_args[@]}" "$tmp/a/$name_a" "$tmp/b/$name_b" || rc=$?
exit "$rc"
