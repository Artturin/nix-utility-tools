#!/usr/bin/env bash
# Compare one or more nixpkgs attributes (package sets or single packages)
# between a base revision (default: merge-base with master) and the working
# tree. Every non-debug output whose store path changed is built on both sides,
# with one nix build per side for all attributes together, and run through
# difflog and diffoscope-nix.

set -euo pipefail

# difflog and diffoscope-nix live next to this script
script_dir=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
PATH="$script_dir${PATH:+:$PATH}"

# --- colours -----------------------------------------------------------------
COLOR_ON=(0 0 0) # indexed by fd: 1 = stdout, 2 = stderr

# Colour each fd that is a terminal, unless NO_COLOR is set. Decided once here,
# outside $(...), where fd 1 is a pipe and would never look like a terminal.
setup_color() {
    local fd
    for fd in 1 2; do
        if [[ -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb && -t $fd ]]; then
            COLOR_ON[fd]=1
        fi
    done
}

# paint FD SGR TEXT... : TEXT wrapped in the SGR style when FD is coloured.
paint() {
    local fd=$1 style=$2
    shift 2
    if ((COLOR_ON[fd])); then
        printf '\e[%sm%s\e[0m' "$style" "$*"
    else
        printf '%s' "$*"
    fi
}

S_STAGE='1;36'    # >>> progress lines
S_SET='1;35'      # attribute names inside progress lines
S_NUM='1;97'      # counts
S_PKG='1;97;44'   # package banner above each diff
S_OUT='1;33'      # --- attr header
S_OUTNAME='36'    # [output]
S_OLD='1;31'      # old side
S_NEW='1;32'      # new side
S_OK='1;32'
S_WARN='1;33'
S_ERR='1;31'
S_DIM='2'

stage() { printf '%s %s\n' "$(paint 2 "$S_STAGE" '>>>')" "$*" >&2; }
note()  { printf '    %s\n' "$(paint 2 "$S_DIM" "$*")" >&2; }
warn()  { printf '%s %s\n' "$(paint 2 "$S_WARN" 'warning:')" "$*" >&2; }
die()   { printf '%s %s\n' "$(paint 2 "$S_ERR" 'error:')" "$*" >&2; exit 1; }

setup_color
# --- end colours -------------------------------------------------------------

usage() {
    cat <<'EOF'
Usage: diff-nixpkgs-attr [options] ATTR...

  ATTR            attribute path in pkgs: a package set, a single package, or
                  one or more of either, e.g.
                    qt6Packages                every package in the set
                    qt6Packages.qtwebengine    just that package
                    qt6Packages.qtbase kdePackages.dolphin
                  flake-style paths (pkgs.X, legacyPackages.SYSTEM.X) work too.
                  Overlapping attributes are only diffed once, and everything
                  is built together, one nix build per side.

  -b, --base REV  revision to compare against
                  (default: merge-base of master and HEAD)
  -n, --dry-run   evaluate both sides, list what would be diffed, and run
                  `nix build --dry-run`; builds nothing and runs no diff tools
      --no-pager  print diffoscope-nix output directly (default: pipe it
                  through a pager when stdout is a terminal)
      --pause     also wait for Enter between packages (q quits)
  -h, --help      show this help

Environment:
  SYSTEM   system to evaluate for      (default: x86_64-linux)
  WORKERS  nix-eval-jobs worker count  (default: 4)
  SOUND    wav file played when builds finish
  DIFF_PAGER   pager for diffoscope-nix output  (default: less -FR)
  NO_COLOR     disable colour (otherwise used on terminals)
EOF
}

DRY_RUN=0
PAUSE=0
USE_PAGER=1
BASE_REV=""
SYSTEM=${SYSTEM:-x86_64-linux}
WORKERS=${WORKERS:-4}
SOUND=${SOUND:-/home/art/bin/filesforscripts/TaskCompletedSound.wav}

while (($#)); do
    case $1 in
        -n|--dry-run) DRY_RUN=1 ;;
        --pause)      PAUSE=1 ;;
        --no-pager)   USE_PAGER=0 ;;
        -b|--base)    BASE_REV=${2:?--base needs a value}; shift ;;
        -h|--help)    usage; exit 0 ;;
        --)           shift; break ;;
        -*)           usage >&2; die "unknown option: $1" ;;
        *)            break ;;
    esac
    shift
done

if (( $# == 0 )); then
    usage >&2
    die "at least one attribute is required"
fi

# Accept flake-style paths: drop a leading "pkgs." or "legacyPackages.SYSTEM.".
normalize_attr() {
    local a=$1
    local re='^legacyPackages\.[A-Za-z0-9_]+-[a-z]+\.(.+)$'
    if [[ $a =~ $re ]]; then
        a=${BASH_REMATCH[1]}
    fi
    printf '%s' "${a#pkgs.}"
}

# Normalise, validate and de-duplicate the attributes before doing any work.
attrs=()
declare -A seen_attr=()
re='^[A-Za-z_][A-Za-z0-9_.-]*$'
for a in "$@"; do
    n=$(normalize_attr "$a")
    [[ $n =~ $re ]] || die "invalid attribute path: $a"
    if [[ -z ${seen_attr[$n]:-} ]]; then
        seen_attr[$n]=1
        attrs+=("$n")
    fi
done

cd "$(git rev-parse --show-toplevel)"
BASE_REV=$(git rev-parse "${BASE_REV:-$(git merge-base master HEAD)}")
OLD_FLAKE="git+file://$PWD?rev=$BASE_REV"
NEW_FLAKE="git+file://$PWD"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

pager=(cat)
if ((USE_PAGER)) && [[ -t 1 ]]; then
    read -ra pager <<< "${DIFF_PAGER:-less -FR}"
fi

build_flags=(--keep-going)
if ((DRY_RUN)); then
    build_flags+=(--dry-run)
fi

# Evaluate ATTR of the nixpkgs at FLAKEREF with aliases disabled; prints
# nix-eval-jobs JSON lines. ATTR may be a set (one line per package) or a single
# derivation (one line with an empty "attr").
# (legacyPackages can't take a config, so import the flake's source directly.)
eval_set() { # FLAKEREF ATTR
    nix run nixpkgs#nix-eval-jobs -- \
        --impure --force-recurse --workers "$WORKERS" --expr "
          let
            flake = builtins.getFlake \"$1\";
            pkgs = import flake.outPath {
              system = \"$SYSTEM\";
              config.allowAliases = false;
            };
          in pkgs.$2
        "
}

# A failed evaluation (e.g. the attribute doesn't exist on the base revision)
# must not abort the script, so it is reported and left to the job count.
eval_side() { # FLAKEREF ATTR OUTFILE SIDE
    if ! eval_set "$1" "$2" > "$3"; then
        warn "evaluating $2 on the $4 side failed"
    fi
}

count_jobs() { # JSONL
    jq -s '[.[] | select(.drvPath != null)] | length' "$1"
}

show_errors() { # JSONL
    { jq -r 'select(.error != null) | .error' "$1" | head -n 3 | sed 's/^/    /'; } >&2 || true
}

# Installables (drv^out1,out2,...) for the jobs in JSONL whose full attribute
# path is listed in WANTED_FILE. The debug output is left out.
installables() { # JSONL WANTED_FILE ATTR
    jq -r --arg set "$3" --rawfile want "$2" '
        def full: if .attr == "" then $set else $set + "." + .attr end;
        ($want | split("\n")) as $w
        | select(.drvPath != null and (full | IN($w[])))
        | ((.outputs // {} | keys) - ["debug"]) as $outs
        | select(($outs | length) > 0)
        | .drvPath + "^" + ($outs | join(","))
    ' "$1" | sort -u
}

# fullattr|output|old path|new path for every non-debug output that differs.
changed_outputs() { # OLD_JSONL NEW_JSONL ATTR
    jq -n -r --arg set "$3" --slurpfile old "$1" --slurpfile new "$2" '
        def full: if .attr == "" then $set else $set + "." + .attr end;
        ($old | map(select(.drvPath != null) | {key: full, value: (.outputs // {})})
              | from_entries) as $o
        | $new[]
        | select(.drvPath != null)
        | full as $attr
        | (.outputs // {}) | to_entries[]
        | select(.key != "debug" and .value != null)
        | select(($o[$attr][.key] // .value) != .value)
        | [$attr, .key, $o[$attr][.key], .value] | join("|")
    '
}

# Evaluate ATTR on both sides and append what changed to the shared lists:
#   $work/changed.txt       fullattr|output|old path|new path
#   $work/old.installables  drv^outputs to build on the base side
#   $work/new.installables  drv^outputs to build on the working-tree side
collect_attr() { # ATTR
    local attr=$1 side errs jobs_old jobs_new n pkgs dir name
    dir=$(mktemp -d -p "$work")
    name=$(paint 2 "$S_SET" "$attr")

    stage "$name: evaluating base $(paint 2 "$S_OLD" "${BASE_REV:0:12}") and $(paint 2 "$S_NEW" 'working tree')"
    eval_side "$OLD_FLAKE" "$attr" "$dir/old.jsonl" base
    eval_side "$NEW_FLAKE" "$attr" "$dir/new.jsonl" "working tree"

    for side in old new; do
        errs=$(jq -s '[.[] | select(.error != null)] | length' "$dir/$side.jsonl")
        if ((errs > 0)); then
            note "$errs eval errors on the $side side (ignored)"
        fi
    done

    jobs_old=$(count_jobs "$dir/old.jsonl")
    jobs_new=$(count_jobs "$dir/new.jsonl")
    if ((jobs_new == 0)); then
        warn "$attr did not evaluate on the working tree; nothing to compare"
        show_errors "$dir/new.jsonl"
        return 0
    fi
    if ((jobs_old == 0)); then
        warn "$attr did not evaluate on the base revision (new attribute?); nothing to compare"
        show_errors "$dir/old.jsonl"
        return 0
    fi

    changed_outputs "$dir/old.jsonl" "$dir/new.jsonl" "$attr" > "$dir/changed.txt"
    n=$(wc -l < "$dir/changed.txt")
    if ((n == 0)); then
        stage "$name: $(paint 2 "$S_OK" 'no changed non-debug outputs')"
        return 0
    fi
    cut -d'|' -f1 "$dir/changed.txt" | sort -u > "$dir/attrs.txt"
    pkgs=$(wc -l < "$dir/attrs.txt")
    stage "$name: $(paint 2 "$S_NUM" "$n") changed non-debug outputs ($(paint 2 "$S_NUM" "$pkgs") package(s))"

    cat "$dir/changed.txt" >> "$work/changed.txt"
    for side in old new; do
        installables "$dir/$side.jsonl" "$dir/attrs.txt" "$attr" >> "$work/$side.installables"
    done
}

build_side() { # SIDE
    local list="$work/$1.installables"
    sort -u "$list" -o "$list"
    stage "building the $1 side ($(paint 2 "$S_NUM" "$(wc -l < "$list")") derivations)"
    nix build --stdin "${build_flags[@]}" --out-link "$work/$1" < "$list" \
        || warn "some $1 builds failed; affected outputs will be skipped"
}

# Wait for Enter so the output above can be read; returns 1 if the user types q.
pause() {
    local reply
    if ! ((PAUSE)) || [[ ! -t 0 ]]; then
        return 0
    fi
    read -r -p "$(paint 2 "$S_DIM" '--- Enter: next package, q: quit ')" reply || return 0
    [[ $reply != q ]]
}

print_pair() { # OLD NEW
    printf '    %s %s\n    %s %s\n' \
        "$(paint 1 "$S_OLD" '-')" "$1" "$(paint 1 "$S_NEW" '+')" "$2"
}

# What difflog and diffoscope-nix reported. Both exit 1 when they find
# differences; any other non-zero status is a tool error. The exception is 141
# from diffoscope-nix: the pager was quit before it finished writing, which
# only happens when there is output, so it counts as a difference.
diff_order=()   # attrs with differences, in the order they were checked
declare -A difflog_found=() diffoscope_outs=()   # attr -> 1 / attr -> "out,dev"
STOPPED=0

mark_diff() { # ATTR
    if [[ -z ${difflog_found[$1]:-} && -z ${diffoscope_outs[$1]:-} ]]; then
        diff_order+=("$1")
    fi
}

show_diffs() { # CHANGED_FILE
    local attr out old new prev="" first=1 rc

    # fd 3 so the diff tools can't swallow the list through stdin.
    # The list is grouped by attr. All outputs of a derivation share one build
    # log, so difflog runs once per attr (on its first changed output).
    while IFS='|' read -r -u 3 attr out old new; do
        if ((first)) || [[ $attr != "$prev" ]]; then
            if ! ((first)) && ! pause; then
                STOPPED=1
                break
            fi
            first=0
            prev=$attr
            printf '\n%s\n' "$(paint 1 "$S_PKG" " $attr ")"
            rc=0
            difflog --sort-lines "$old" "$new" -U0 || rc=$?
            case $rc in
                0) ;;
                1) mark_diff "$attr"; difflog_found[$attr]=1 ;;
                *) warn "difflog exited with status $rc for $attr" ;;
            esac
        fi
        printf '%s %s\n' "$(paint 1 "$S_OUT" "--- $attr")" "$(paint 1 "$S_OUTNAME" "[$out]")"
        if [[ ! -e $old || ! -e $new ]]; then
            warn "skipped: build output missing"
            print_pair "$old" "$new" >&2
            continue
        fi
        rc=0
        diffoscope-nix "$old" "$new" | "${pager[@]}" || rc=${PIPESTATUS[0]}
        case $rc in
            0) ;;
            1|141)
                mark_diff "$attr"
                diffoscope_outs[$attr]+="${diffoscope_outs[$attr]:+,}$out"
                ;;
            *) warn "diffoscope-nix exited with status $rc for $attr [$out]" ;;
        esac
    done 3< "$1"
}

print_summary() {
    local attr s parts padded width=0
    for attr in "${diff_order[@]}"; do
        ((${#attr} <= width)) || width=${#attr}
    done
    printf '\n'
    if ((${#diff_order[@]} == 0)); then
        printf '%s\n' "$(paint 1 "$S_OK" 'No differences reported by difflog or diffoscope-nix')"
    else
        printf '%s\n' "$(paint 1 "$S_WARN" "Differences found in ${#diff_order[@]} attribute(s):")"
        for attr in "${diff_order[@]}"; do
            parts=()
            if [[ -n ${difflog_found[$attr]:-} ]]; then
                parts+=(difflog)
            fi
            if [[ -n ${diffoscope_outs[$attr]:-} ]]; then
                parts+=("diffoscope-nix [${diffoscope_outs[$attr]}]")
            fi
            printf -v s '%s, ' "${parts[@]}"
            printf -v padded '%-*s' "$width" "$attr"
            printf '  %s  %s\n' "$(paint 1 "$S_OUT" "$padded")" "$(paint 2 "$S_OUTNAME" "${s%, }")"
        done
    fi
    if ((STOPPED)); then
        printf '%s\n' "$(paint 2 "$S_DIM" '(stopped early: later attributes were not checked)')"
    fi
}

: > "$work/changed.txt"
: > "$work/old.installables"
: > "$work/new.installables"

for attr in "${attrs[@]}"; do
    collect_attr "$attr"
done

# Overlapping attributes (a set and one of its members) yield identical lines;
# keep the first occurrence so the order follows the command line.
awk '!seen[$0]++' "$work/changed.txt" > "$work/changed.uniq"
total=$(wc -l < "$work/changed.uniq")
((total > 0)) || exit 0

if ((${#attrs[@]} > 1)); then
    pkgs=$(cut -d'|' -f1 "$work/changed.uniq" | sort -u | wc -l)
    stage "in total $(paint 2 "$S_NUM" "$total") changed non-debug outputs ($(paint 2 "$S_NUM" "$pkgs") package(s))"
fi

for side in old new; do
    build_side "$side"
done

if ((DRY_RUN)); then
    while IFS='|' read -r attr out old new; do
        printf '%s %s %s\n' "$(paint 1 "$S_OK" 'would diff')" "$attr" \
            "$(paint 1 "$S_OUTNAME" "[$out]")"
        print_pair "$old" "$new"
    done < "$work/changed.uniq"
    exit 0
fi

pw-cat --playback "$SOUND" || true

show_diffs "$work/changed.uniq"
print_summary
